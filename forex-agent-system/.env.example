# =============================================================================
# forex-agent-system configuration copy.
# Copy to `.env` and fill in real values. Never hardcode secrets in source.
# =============================================================================

# --- Trading mode -----------------------------------------------------------
# "paper" (default, simulated fills) or "live" (real broker orders).
# Switching to "live" requires a documented human sign-off AFTER a successful
# backtest over the minimum window — see README (section 8). The system
# refuses to place a live order unless TRADING_MODE is exactly "live".
TRADING_MODE=paper

# --- Instrument / compliance -------------------------------------------------
# Default instrument to trade. Only RBI/SEBI authorized exchange-traded
# currency derivatives are allowed (USDINR/EURINR/GBPINR/JPYINR on NSE/BSE/MSE).
DEFAULT_INSTRUMENT=USDINR
ACCOUNT_EQUITY=100000.0
RISK_PER_TRADE_PCT=1.5        # max % of equity risked per trade (1–2% band)
SL_PIPS=30                    # default stop-loss distance in pips
TP_PIPS=60                    # default take-profit distance in pips
ALLOWED_INSTRUMENTS=USDINR,EURINR,GBPINR,JPYINR

# --- Backtest gate ------------------------------------------------------------
BACKTEST_MIN_YEARS=2
BACKTEST_CSV_PATH=backtest/data/historical_usdinr.csv

# --- MCP server / broker endpoints --------------------------------------------
# Point these at your commercial MCP servers if you have them; otherwise
# the local stub servers from mcp/servers/ are used.
MARKET_DATA_MCP_URL=
NEWS_CALENDAR_MCP_URL=
BROKER_MCP_URL=
BROKER_API_KEY=
BROKER_BASE_URL=

# --- Model / LangChain ---------------------------------------------------------
# Model used ONLY for the sentiment-classification step (never for trade
# decisions — those come from rules/signal_rules.yaml).
SENTIMENT_MODEL=groq/llama-3.1-8b-instant
SENTIMENT_TEMPERATURE=0.0

# --- Observability (LangSmith) -------------------------------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=forex-multi-agent
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# --- Storage -------------------------------------------------------------------
DATABASE_URL=sqlite:///forex_trades.db   # SQLite for local prototyping
REDIS_URL=redis://localhost:6379/0
